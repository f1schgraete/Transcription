<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_background"
    android:padding="16dp">

    <!-- Caller name / number — very large for elderly readability -->
    <TextView
        android:id="@+id/tv_caller"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/text_on_dark"
        android:gravity="center"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status (Verbinde / Klingelt / Aktiver Anruf) -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="@color/text_on_dark_secondary"
        android:gravity="center"
        android:paddingTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tv_caller"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call duration timer -->
    <TextView
        android:id="@+id/tv_duration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="22sp"
        android:textColor="@color/text_on_dark_secondary"
        android:gravity="center"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/tv_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ======= OUTGOING RINGING BUTTONS ======= -->
    <LinearLayout
        android:id="@+id/layout_calling"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_hang_up_ringing"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="Auflegen"
            android:textSize="24sp"
            android:textStyle="bold"
            android:backgroundTint="@color/call_red" />

    </LinearLayout>

    <!-- ======= INCOMING CALL BUTTONS ======= -->
    <!--
        Vertical layout: green Annehmen on top (larger, more prominent),
        red Ablehnen below (smaller). This minimises accidental hang-ups.
    -->
    <LinearLayout
        android:id="@+id/layout_incoming"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Accept: full width, very tall, bright green — hardest to miss -->
        <Button
            android:id="@+id/btn_accept"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:text="Annehmen"
            android:textSize="28sp"
            android:textStyle="bold"
            android:backgroundTint="@color/call_green"
            android:layout_marginBottom="16dp" />

        <!-- Decline: narrower, shorter, less prominent -->
        <Button
            android:id="@+id/btn_decline"
            android:layout_width="220dp"
            android:layout_height="72dp"
            android:text="Ablehnen"
            android:textSize="20sp"
            android:backgroundTint="@color/call_red" />

    </LinearLayout>

    <!-- ======= ACTIVE CALL BUTTONS ======= -->
    <LinearLayout
        android:id="@+id/layout_active"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_hang_up"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="Auflegen"
            android:textSize="24sp"
            android:textStyle="bold"
            android:backgroundTint="@color/call_red" />

        <!-- Shown after call ends instead of Auflegen -->
        <Button
            android:id="@+id/btn_loeschen"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="Schlie&#xDF;en"
            android:textSize="22sp"
            android:visibility="gone"
            android:backgroundTint="@color/mic_off" />

    </LinearLayout>

    <!-- Barrier sits at the top of whichever button layout is currently visible. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="layout_calling,layout_incoming,layout_active" />

    <!-- ======= TRANSCRIPTION AREA (fills remaining vertical space) ======= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_transcript"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/transcript_bg"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_duration"
        app:layout_constraintBottom_toTopOf="@id/barrier_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:id="@+id/scroll_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.5" />

        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
