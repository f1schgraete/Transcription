<?xml version="1.0" encoding="utf-8"?>
<!--
  "Verpasste Anrufe" — shown when a call ends without being answered
  (incoming missed or outgoing not reached), instead of leaving the user on
  the call/Auflegen screen. Lists the not-answered calls newest-first with a
  one-tap Zurückrufen per entry. Landscape, full-screen kiosk.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:background="@color/surface"
        android:elevation="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Verpasste Anrufe"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ll_missed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />

    </ScrollView>

    <Button
        android:id="@+id/btn_close"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_margin="12dp"
        android:text="Schließen"
        android:textSize="22sp"
        android:textStyle="bold"
        android:backgroundTint="@color/call_green"
        android:elevation="4dp" />

</LinearLayout>
