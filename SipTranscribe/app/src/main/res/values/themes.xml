<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SipTranscribe" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">#0D47A1</item>
        <item name="colorOnPrimary">@color/text_on_dark</item>
        <item name="colorSecondary">@color/call_green</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!--
        DialButton style used by every key in the 3x4 dialpad grid.
        Uses layout_columnWeight / layout_rowWeight so all keys share space evenly.
    -->
    <style name="DialButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_margin">4dp</item>
    </style>

</resources>
