<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget metadata. updatePeriodMillis is 0 because we never schedule
  periodic refreshes — the widget content only changes when the
  caregiver re-configures it. resizeMode lets the user stretch the
  widget on the home screen.

  android:configure points at the activity launched by the launcher when
  the widget is dragged onto the home screen; that activity picks a
  contact and writes (name, number) into SharedPreferences keyed by
  the new widget's id.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="80dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_contact"
    android:configure="com.siptranscribe.app.WidgetConfigActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
