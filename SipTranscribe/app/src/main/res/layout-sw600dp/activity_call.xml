<?xml version="1.0" encoding="utf-8"?>
<!--
  Tablet call screen (sw600dp+).
  Same structure and IDs as the phone layout; larger text, more padding, bigger buttons.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_background"
    android:padding="24dp">

    <!-- Caller name -->
    <TextView
        android:id="@+id/tv_caller"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="44sp"
        android:textStyle="bold"
        android:textColor="@color/text_on_dark"
        android:gravity="center"
        android:paddingTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="@color/text_on_dark_secondary"
        android:gravity="center"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_caller"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Timer -->
    <TextView
        android:id="@+id/tv_duration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="28sp"
        android:textColor="@color/text_on_dark_secondary"
        android:gravity="center"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/tv_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Outgoing ringing buttons ── -->
    <LinearLayout
        android:id="@+id/layout_calling"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_hang_up_ringing"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:text="Auflegen"
            android:textSize="28sp"
            android:textStyle="bold"
            android:backgroundTint="@color/call_red" />

    </LinearLayout>

    <!-- ── Incoming call buttons ── -->
    <LinearLayout
        android:id="@+id/layout_incoming"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_accept"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:text="Annehmen"
            android:textSize="34sp"
            android:textStyle="bold"
            android:backgroundTint="@color/call_green"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btn_decline"
            android:layout_width="260dp"
            android:layout_height="88dp"
            android:text="Ablehnen"
            android:textSize="24sp"
            android:backgroundTint="@color/call_red" />

    </LinearLayout>

    <!-- ── Active call buttons ── -->
    <LinearLayout
        android:id="@+id/layout_active"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_hang_up"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:text="Auflegen"
            android:textSize="28sp"
            android:textStyle="bold"
            android:backgroundTint="@color/call_red" />

        <Button
            android:id="@+id/btn_loeschen"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="Schlie&#xDF;en"
            android:textSize="24sp"
            android:visibility="gone"
            android:backgroundTint="@color/mic_off" />

    </LinearLayout>

    <!-- Barrier at top of whichever button layout is visible -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="layout_calling,layout_incoming,layout_active" />

    <!-- ── Transcription card (fills the middle) ── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_transcript"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/transcript_bg"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_duration"
        app:layout_constraintBottom_toTopOf="@id/barrier_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Untertitel"
                android:textSize="15sp"
                android:textColor="#888888"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="4dp" />

            <!-- Scrollable transcript history -->
            <ScrollView
                android:id="@+id/scroll_history"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.5" />

            </ScrollView>

            <!-- Live partial result -->
            <TextView
                android:id="@+id/tv_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:padding="16dp"
                android:minHeight="80dp"
                android:gravity="center" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
