<?xml version="1.0" encoding="utf-8"?>
<!--
  Tablet call screen.
  Sized for ~1500dp × ~900dp landscape (e.g. Lenovo Tab Plus 2000×1200 px).
  Layout mirrors the phone-landscape variant: a compact single-row header,
  a transcript/summary split that takes most of the vertical space, and
  a single horizontal row of action buttons at the bottom. Earlier 100dp+
  buttons were eating half the screen on this device — the new ones are
  ~72dp and laid out side-by-side.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_background"
    android:padding="14dp">

    <!--
        Compact header row. Caller name dominates so the user identifies
        the call at a glance. Status text is small — it changes value as
        the call progresses (Klingelt → Aktiver Anruf → Anruf beendet)
        and we keep it visually quiet so it doesn't pull attention away
        from the transcript.
    -->
    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_caller"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_dark"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_on_dark_secondary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Battery in the in-call header so the user can see it while
             talking; kiosk-pinned apps hide the system status bar. -->
        <TextView
            android:id="@+id/tv_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_on_dark_secondary"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="22sp"
            android:textColor="@color/text_on_dark_secondary"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Outgoing ringing: full-width hang-up. -->
    <LinearLayout
        android:id="@+id/layout_calling"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_hang_up_ringing"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="Auflegen"
            android:textSize="22sp"
            android:textStyle="bold"
            android:backgroundTint="@color/call_red" />

    </LinearLayout>

    <!--
        Incoming call: Annehmen on the left and bigger (2:1 weight) so it
        is unambiguously the primary action. Ablehnen is smaller so an
        accidental tap is much less likely to reject a real call.
    -->
    <LinearLayout
        android:id="@+id/layout_incoming"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_accept"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="2"
            android:text="Annehmen"
            android:textSize="26sp"
            android:textStyle="bold"
            android:backgroundTint="@color/call_green"
            android:layout_marginEnd="14dp" />

        <Button
            android:id="@+id/btn_decline"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:text="Ablehnen"
            android:textSize="20sp"
            android:backgroundTint="@color/call_red" />

    </LinearLayout>

    <!--
        Active call: a single Auflegen button — no Speaker on tablet
        because the device has only one (omnidirectional) speaker and the
        system volume rocker already controls call audio. btn_loeschen
        overlays Auflegen after the call ends, keeping the action in the
        same physical spot on screen.
    -->
    <LinearLayout
        android:id="@+id/layout_active"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_hang_up"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="Auflegen"
            android:textSize="26sp"
            android:textStyle="bold"
            android:backgroundTint="@color/call_red" />

        <Button
            android:id="@+id/btn_loeschen"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="Schlie&#xDF;en"
            android:textSize="22sp"
            android:visibility="gone"
            android:backgroundTint="@color/mic_off" />

    </LinearLayout>

    <!--
        Big caller-name banner. Shown only while the call is ringing
        (incoming or outgoing setup) so the user instantly knows who is
        on the other end without having to read the small header. Hidden
        from showActiveUI onwards. Constrained to fill the same area as
        transcript_row so transcript_row can stay GONE during ringing
        and there's no visual jumping when the active UI takes over.
    -->
    <TextView
        android:id="@+id/tv_caller_big"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="@color/text_on_dark"
        android:maxLines="2"
        android:ellipsize="end"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/header_row"
        app:layout_constraintBottom_toTopOf="@id/barrier_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sits at the top of whichever button layout is currently visible. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="layout_calling,layout_incoming,layout_active" />

    <!--
        Main row: transcript left, summary right. 2:1 split — the
        transcript gets two-thirds of the width because that is what the
        hearing-impaired user actually reads. The summary on the right
        is a caregiver-facing reference and can sit comfortably in the
        remaining third. Both cards stay visible for the entire call;
        only the text inside ever changes.
    -->
    <LinearLayout
        android:id="@+id/transcript_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/header_row"
        app:layout_constraintBottom_toTopOf="@id/barrier_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_transcript"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/transcript_bg"
            app:cardElevation="3dp">

            <ScrollView
                android:id="@+id/scroll_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tv_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.4" />

            </ScrollView>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_summary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/transcript_bg"
            app:cardElevation="3dp">

            <!--
                Summary should fit on a single screen. Deliberately NOT in
                a ScrollView: if the analyser produces too much text the
                view clips at the bottom, which is the signal to shorten
                the prompt's output rather than make the user scroll a
                second pane.
            -->
            <TextView
                android:id="@+id/tv_summary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp"
                android:text="Zusammenfassung erscheint, sobald genug gesprochen wurde."
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.35" />

        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
