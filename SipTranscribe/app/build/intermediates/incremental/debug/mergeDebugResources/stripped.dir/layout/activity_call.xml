<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_background"
    android:padding="16dp">

    <!-- Caller name / number -->
    <TextView
        android:id="@+id/tv_caller"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_on_dark"
        android:gravity="center"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status (Connecting / Active / Ringing...) -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/text_on_dark_secondary"
        android:gravity="center"
        android:paddingTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_caller"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call duration timer -->
    <TextView
        android:id="@+id/tv_duration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="20sp"
        android:textColor="@color/text_on_dark_secondary"
        android:gravity="center"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/tv_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ======= TRANSCRIPTION AREA (fills remaining vertical space) ======= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_transcript"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/transcript_bg"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_duration"
        app:layout_constraintBottom_toTopOf="@id/layout_incoming"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Untertitel"
                android:textSize="12sp"
                android:textColor="#888888"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <!-- Scrollable history of finalised transcription segments -->
            <ScrollView
                android:id="@+id/scroll_history"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.4" />

            </ScrollView>

            <!-- Live partial result (shown in a distinct accent colour) -->
            <TextView
                android:id="@+id/tv_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:padding="12dp"
                android:minHeight="64dp"
                android:gravity="center" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ======= INCOMING CALL BUTTONS ======= -->
    <LinearLayout
        android:id="@+id/layout_incoming"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_decline"
            android:layout_width="140dp"
            android:layout_height="64dp"
            android:text="Ablehnen"
            android:textSize="18sp"
            android:backgroundTint="@color/call_red"
            android:layout_marginEnd="24dp" />

        <Button
            android:id="@+id/btn_accept"
            android:layout_width="140dp"
            android:layout_height="64dp"
            android:text="Annehmen"
            android:textSize="18sp"
            android:backgroundTint="@color/call_green" />

    </LinearLayout>

    <!-- ======= ACTIVE CALL BUTTONS ======= -->
    <LinearLayout
        android:id="@+id/layout_active"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mic toggle button -->
        <Button
            android:id="@+id/btn_toggle_mic"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Mikrofon AUS - Tippen zum Sprechen"
            android:textSize="14sp"
            android:backgroundTint="@color/mic_off"
            android:layout_marginBottom="12dp" />

        <!-- Hang up button -->
        <Button
            android:id="@+id/btn_hang_up"
            android:layout_width="160dp"
            android:layout_height="64dp"
            android:text="Auflegen"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@color/call_red" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
